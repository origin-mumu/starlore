# Starlore 后端环境变量配置

# ---------- 服务 ----------
APP_PORT=5000
APP_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ro-blog
DB_PASSWORD=change-me
DB_NAME=ro-blog
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# ---------- JWT ----------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=604800000

# ---------- MinIO ----------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=my-files

# ---------- AI 默认配置 (本地回退) ----------
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ---------- MCP 外部工具接入（可选） ----------
# JSON 数组，每个元素描述一个 MCP Server
# 配置后，Agent 将自动加载这些外部工具与本机工具合并使用
# 例：接入 Brave Search 搜索引擎
# MCP_SERVERS='[{"name":"brave-search","command":"npx","args":["-y","@anthropic/mcp-server-brave-search"],"env":{"BRAVE_API_KEY":"your-key"}}]'
MCP_SERVERS=[]

# ---------- LangSmith（可选） ----------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=starlore
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---------- Agent 执行器 ----------
AGENT_EXECUTOR_CORE_SIZE=4
AGENT_EXECUTOR_MAX_SIZE=8
AGENT_EXECUTOR_QUEUE_CAPACITY=100

# ---------- 外部开放平台 / 网络搜索 ----------
ZHIPU_API_KEY=

